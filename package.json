{
  "name": "hack-club-program-onboarding",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:github": "tsc -b && vite build --mode github",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "@plausible-analytics/tracker": "^0.4.6",
    "@vitejs/plugin-react": "4.4.1",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "6.4.3",
    "yaml": "latest"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
